{
    "python-envs.defaultEnvManager": "ms-python.python:poetry",
    "python-envs.defaultPackageManager": "ms-python.python:poetry",
    "flake8.args": [
        "--max-line-length=100"
    ],
    "black-formatter.args": [
        "--line-length",
        "100"
    ],
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "cSpell.words": [
        "allf",
        "atleast",
        "axhline",
        "axvline",
        "bfit",
        "Bmax",
        "bottomrule",
        "brentq",
        "capthick",
        "Clopper",
        "columnspacing",
        "compresslevel",
        "covariates",
        "ddof",
        "elinewidth",
        "eraw",
        "errorbar",
        "exceedance",
        "expit",
        "figsize",
        "finfo",
        "flatnonzero",
        "fontset",
        "fontsize",
        "fonttype",
        "frameon",
        "ftol",
        "fullmean",
        "groupkeys",
        "halfwidth",
        "handlelength",
        "ineq",
        "ineqlin",
        "isposinf",
        "isscalar",
        "keepdims",
        "labelsize",
        "labelspacing",
        "linalg",
        "linestyle",
        "linprog",
        "logaddexp",
        "logterm",
        "markeredgewidth",
        "markerfacecolor",
        "markersize",
        "markevery",
        "mathrm",
        "mathtext",
        "maxiter",
        "mcse",
        "meshrows",
        "midrule",
        "mininterval",
        "multinomial",
        "ndtr",
        "ndtri",
        "nextafter",
        "noncrossing",
        "popmom",
        "prec",
        "Prespecified",
        "proba",
        "RDONLY",
        "rhsval",
        "rtol",
        "savez",
        "SLSQP",
        "tanaudit",
        "textasciicircum",
        "textasciitilde",
        "textbackslash",
        "titlesize",
        "toprule",
        "truthmom",
        "waterfill",
        "xlabel",
        "xlogy",
        "xscale",
        "xtick",
        "xticklabels",
        "xticks",
        "xtol",
        "yerr",
        "ylabel",
        "ylim",
        "ytick"
    ]
}